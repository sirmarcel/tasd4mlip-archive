# Figure defaults for the sadmof write-ups. Sized and fonted for the NeurIPS
# preprint (10 pt Times, 5.5 in text width) so a figure saved at its natural
# size needs no scaling in \includegraphics.
#
# `text.usetex` needs a LaTeX install with the preamble packages below; set
# SADMOF_NO_USETEX=1 to fall back to mathtext (see tbx/__init__.py).

figure.figsize      : 5.5, 3.0
figure.dpi          : 200

font.family         : serif
font.serif          : Times, Times New Roman, DejaVu Serif, serif
font.size           : 10.0
text.usetex         : True
text.latex.preamble : \usepackage{amsmath}\usepackage{amssymb}\usepackage{siunitx}\DeclareSIUnit\angstrom{\text{Å}}
mathtext.default    : regular

axes.labelsize      : 10.0
axes.titlesize      : 10.0
axes.linewidth      : 0.8

lines.linewidth     : 1.5
lines.dash_capstyle : round

xtick.direction     : inout
ytick.direction     : inout
xtick.labelsize     : 9.0
ytick.labelsize     : 9.0

legend.frameon      : False
legend.fontsize     : 9.0
legend.handlelength : 1.8

savefig.dpi         : 300
